{
"compilerOptions": {
"target": "ES2020",
"module": "node16",
"moduleResolution": "node16",
"esModuleInterop": true,
"strict": true,
"jsx": "react-jsx",
"types": ["jest", "@testing-library/jest-dom"],
"skipLibCheck": true,
"noUncheckedSideEffectImports": false,
"baseUrl": ".",
"paths": {
"@/*": ["src/*"]
}
},
"include": ["src/**/*.ts", "src/**/*.tsx", "jest.setup.ts"]
}
